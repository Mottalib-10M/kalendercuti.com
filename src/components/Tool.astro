---
/** L'outil d'une page : un simulateur déclaratif de tool-specs.ts, le calendrier annuel ou le compte à rebours. */
import SpecTool from './calc/SpecTool';
import Kalender from './bt/Kalender';
import HitungMundur from './bt/HitungMundur';
import { route } from '../i18n/routes';
import type { Lang } from '../lib/format';
interface Props { kind: string; lang: Lang; arg?: Record<string, number | string>; idPrefix?: string }
const { kind, lang, arg, idPrefix = 't' } = Astro.props;
const methodHref = route('method', lang);
---
{kind === 'kalender' ? <Kalender client:load lang={lang} year={Number(arg?.tahun ?? 2027)} cetak={!!arg?.cetak} methodHref={methodHref} idPrefix={idPrefix} />
  : kind === 'mundur' ? <HitungMundur client:load lang={lang} def={arg?.hari ? String(arg.hari) : undefined} methodHref={methodHref} idPrefix={idPrefix} />
  : <SpecTool client:load kind={kind} lang={lang} arg={arg ? JSON.stringify(arg) : undefined} methodHref={methodHref} idPrefix={idPrefix} />}
