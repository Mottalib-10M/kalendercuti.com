---
/** Pages à intégrer (iframe) : un outil seul, en indonésien et en anglais. noindex, hors sitemap (astro.config). */
import '../../../styles/global.css';
import Tool from '../../../components/Tool.astro';
import { SITE_URL, SITE_NAMES, LANG_TAGS } from '../../../data/site-config';
import { route } from '../../../i18n/routes';
import type { Lang } from '../../../lib/format';
const EMBEDS = {
  'kalender': { kind: 'kalender', arg: { tahun: 2027 }, page: 'home', t: { id: 'Kalender 2027 Indonesia', en: 'Indonesia calendar 2027' } },
  'perencana-cuti': { kind: 'lw', arg: undefined, page: 'long-weekend-2027', t: { id: 'Perencana cuti dan long weekend', en: 'Indonesia leave planner and long weekends' } },
} as const;
export function getStaticPaths() {
  return (['id', 'en'] as const).flatMap((lang) => ['kalender', 'perencana-cuti'].map((name) => ({ params: { lang, name } })));
}
const { lang, name } = Astro.params as { lang: Lang; name: keyof typeof EMBEDS };
const e = EMBEDS[name];
const page = `${SITE_URL}${route(e.page, lang)}`;
const note = { id: 'Isian tetap di perangkat Anda · alat dari Radif Partners, bukan layanan pemerintah', en: 'What you enter stays on your device · tool by Radif Partners, not a government service' }[lang];
---
<!doctype html>
<html lang={LANG_TAGS[lang]}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{`${e.t[lang]} (${lang === 'id' ? 'untuk dipasang' : 'embed'})`}</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={page} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <main><Tool kind={e.kind} lang={lang} arg={e.arg} idPrefix="embed" /></main>
    <p class="mt-2 text-center text-xs text-navy-600"><a href={page} target="_blank" rel="noopener" class="underline">{SITE_NAMES[lang]}</a> · {note}</p>
  </body>
</html>
