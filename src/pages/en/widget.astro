---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = (name: string, t: string, h: number) => `<iframe src="${SITE_URL}/embed/${lang}/${name}/" title="${t}" width="100%" height="${h}" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
const items = [
  { name: 'kalender', h2: 'Indonesia calendar 2027 with holidays', text: 'Twelve months, national holidays and collective leave from the joint decree, with Hijri dates or Javanese pasaran on request.', t: 'Indonesia calendar 2027', h: 1400 },
  { name: 'perencana-cuti', h2: 'Leave planner and long weekends', text: 'Year and leave days: your readers see the best plan and every long weekend straight away.', t: 'Indonesia leave planner and long weekends', h: 980 },
];
---
<PageLayout title="Embed the Indonesia calendar 2027 free: holidays and planner" description="Embed the Indonesia 2027 calendar and leave planner on your site for free with an iframe: copy the code once, and each new joint decree appears on your site by itself." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the calendar and leave planner</h1>
    <p class="mt-3 text-lg text-navy-700">For offices, HR teams, schools, communities and local media: copy once, new years appear by themselves.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    {items.map((i) => (<>
      <h2>{i.h2}</h2>
      <p>{i.text}</p>
      <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code(i.name, i.t, i.h)}</code></pre>
    </>))}
    <p>For the Indonesian version, replace <code>/embed/en/</code> with <code>/embed/id/</code>. Terms: the source link under the tool stays visible, the tool is not altered and is provided without warranty. What your readers enter stays on their device. Questions through the <a href={route('contact', lang)}>contact page</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src={`/embed/${lang}/perencana-cuti/`} title="Indonesia leave planner and long weekends" width="100%" height="980" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
